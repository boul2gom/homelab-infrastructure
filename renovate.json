{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    ":semanticCommits",
    ":dependencyDashboard",
    ":disableRateLimiting"
  ],
  "timezone": "Europe/Paris",
  "labels": ["dependencies", "docker"],

  "commitMessagePrefix": "chore({{parentDir}}):",
  "commitMessageAction": "update",
  "commitMessageTopic": "{{depName}}",
  "commitMessageExtra": "from {{currentVersion}} to {{newVersion}}",

  "docker-compose": {
    "managerFilePatterns": [
      "/(^|/)(?:docker-)?compose[^/]*\\.ya?ml$/"
    ]
  },

  "packageRules": [
    {
      "description": "Global Docker rule: ignore unstable tags, enforce commit/PR format, and add an Arcane GitOps note to PRs",
      "matchDatasources": ["docker"],
      "ignoreUnstable": true,
      "allowedVersions": "!/^(latest|main|master|edge|nightly|dev|release|stable|alpine)$/",
      "commitMessageAction": "update",
      "commitMessageTopic": "{{depName}}",
      "commitMessageExtra": "from {{currentVersion}} to {{newVersion}}",
      "prBodyNotes": [
        "---",
        "🔄 **Arcane GitOps**: Merging this Pull Request will trigger **Arcane** to automatically sync the `{{parentDir}}` project and redeploy the updated container."
      ]
    },
    {
      "description": "Automerge patch updates (x.y.Z) for stable versions >= 1.0.0 after a 3-day stability period",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["patch"],
      "minimumReleaseAge": "3 days",
      "automerge": true
    },
    {
      "description": "Disable automerge on all 0.x.y versions (e.g. GoDoxy, Blocky, Scrutiny, Calibre-Web, NetBird) as patch releases often include new features",
      "matchDatasources": ["docker"],
      "matchCurrentVersion": "/^v?0\\./",
      "automerge": false
    },
    {
      "description": "Memos uses CalVer (e.g. 26.11.0): disable automerge so new features in release notes are not missed",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["neosmemo/memos"],
      "automerge": false
    },
    {
      "description": "Highlight major updates with a dedicated label, breaking change prefix (!), and warning banner",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "docker", "major-update"],
      "commitMessagePrefix": "chore({{parentDir}})!:",
      "commitMessageAction": "major update",
      "prBodyNotes": [
        "⚠️ **MAJOR UPDATE**: Carefully review the Release Notes below for potential *Breaking Changes* or database migrations before merging."
      ]
    },
    {
      "description": "Immich Postgres (VectorChord): parse <pg_major>-vectorchord<x.y.z> tag format",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/immich-app/postgres"],
      "versioning": "regex:^(?<major>\\d+)-vectorchord(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)(?<compatibility>-.*)?$",
      "automerge": false
    },
    {
      "description": "Databases (Postgres & Immich Postgres): never propose automatic major Postgres version upgrades (requires manual pg_upgrade/dump)",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "postgres",
        "ghcr.io/immich-app/postgres"
      ],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Group Immich Server and Immich Machine Learning (openvino) into a single PR",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/immich-app/immich-server",
        "ghcr.io/immich-app/immich-machine-learning"
      ],
      "groupName": "immich",
      "commitMessageTopic": "immich",
      "commitMessageExtra": "to {{newVersion}}"
    },
    {
      "description": "Group Scrutiny Web and Scrutiny Collector into a single PR",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/analogj/scrutiny"],
      "groupName": "scrutiny",
      "commitMessageTopic": "scrutiny",
      "commitMessageExtra": "to {{newVersion}}"
    },
    {
      "description": "Group the entire NetBird stack into a single PR",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "netbirdio/dashboard",
        "netbirdio/management",
        "netbirdio/signal",
        "netbirdio/relay",
        "netbirdio/netbird"
      ],
      "groupName": "netbird",
      "commitMessageTopic": "netbird stack",
      "commitMessageExtra": "to {{newVersion}}"
    },
    {
      "description": "Blocky: support 2-digit version numbers (e.g. v0.25)",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/0xerr0r/blocky"],
      "versioning": "loose"
    },
    {
      "description": "Kener: ignore development main-with-docs-* tags",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["rajnandan1/kener"],
      "allowedVersions": "!/^main/"
    },
    {
      "description": "LinuxServer.io: ignore build-specific -lsXXX tags and keep clean SemVer versions only",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["lscr.io/linuxserver/**"],
      "allowedVersions": "!/.*-ls\\d+$/"
    },
    {
      "description": "Calibre-Web (LinuxServer.io): ignore legacy Calibre Desktop 5.x tags accidentally published to the calibre-web repository in 2021",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["lscr.io/linuxserver/calibre-web"],
      "allowedVersions": "!/^5\\./"
    },
    {
      "description": "Arcane Manager: upgraded directly via Arcane UI (Settings -> Updates) and synced back via Git Backup Push",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/getarcaneapp/manager"],
      "enabled": false
    }
  ]
}
